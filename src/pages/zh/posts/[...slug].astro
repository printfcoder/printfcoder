---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { lpath, type Locale } from '../../../lib/i18n';
import type { GetStaticPaths } from 'astro';

const locale: Locale = 'zh';
const pairKey = (id: string) => id.replace(/\.(en|zh)$/, '');

export const getStaticPaths = (async () => {
  const [zhPosts, enPosts] = await Promise.all([
    getCollection('posts', (p) => !p.data.draft && p.data.lang === 'zh'),
    getCollection('posts', (p) => !p.data.draft && p.data.lang === 'en'),
  ]);
  const enKeys = new Set(enPosts.map((p) => pairKey(p.id)));
  return zhPosts.map((post) => ({
    params: { slug: pairKey(post.id) },
    props: {
      post,
      counterpart: enKeys.has(pairKey(post.id))
        ? lpath('en', `/posts/${pairKey(post.id)}`)
        : undefined,
    },
  }));
}) satisfies GetStaticPaths;

const { post, counterpart } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout
  locale={locale}
  page="blog"
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  counterpart={counterpart}
>
  <Content />
</ArticleLayout>
