---
import LearnView from '../../views/LearnView.astro';
import { CATEGORIES, type CategorySlug } from '../../lib/i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () =>
  CATEGORIES.map((c) => ({ params: { category: c.slug } }))) satisfies GetStaticPaths;

const { category } = Astro.params as { category: CategorySlug };
---

<LearnView locale="en" category={category} />
