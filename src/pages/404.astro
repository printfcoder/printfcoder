---
import BaseLayout from '../layouts/BaseLayout.astro';
import { UI } from '../lib/i18n';
---

<BaseLayout locale="en" page="hello" title="404 — Not found">
  <section class="shell" style="padding-block: 140px 180px; text-align: center">
    <p class="eyebrow">404</p>
    <h1 style="font-size: 2rem; font-weight: 800; margin-top: 14px">{UI.en.notFound.title}</h1>
    <p style="margin-top: 12px; color: var(--color-ink-2)">{UI.en.notFound.body}</p>
    <p style="margin-top: 8px; color: var(--color-ink-muted); font-size: 0.92rem">
      {UI.zh.notFound.title} — {UI.zh.notFound.body}
    </p>
    <a class="btn btn--ghost" href="/" style="margin-top: 28px">{UI.en.notFound.back}</a>
  </section>
</BaseLayout>
