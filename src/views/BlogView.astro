---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList, { type Entry } from '../components/EntryList.astro';
import { getCollection } from 'astro:content';
import { UI, lpath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];

const posts = (await getCollection('posts', (p) => !p.data.draft && p.data.lang === locale)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const baseKey = (id: string) => id.replace(/\.(en|zh)$/, '');

const entries: Entry[] = posts.map((p) => ({
  href: lpath(locale, `/posts/${baseKey(p.id)}`),
  title: p.data.title,
  date: p.data.pubDate,
  description: p.data.description,
}));
---

<BaseLayout locale={locale} page="blog" title={`${t.blog.eyebrow} · Blog`} description={t.blog.subtitle}>
  <div class="shell">
    <header class="page-head">
      <p class="eyebrow">{locale === 'zh' ? '博客' : '博客 · Blog'}</p>
      <h1 class="page-head__title">{t.blog.title}</h1>
      <p class="page-head__subtitle">{t.blog.subtitle}</p>
    </header>
  </div>

  <EntryList entries={entries} locale={locale} />
</BaseLayout>
