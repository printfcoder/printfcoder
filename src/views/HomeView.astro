---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, UI, CATEGORIES, lpath, type Locale } from '../lib/i18n';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];

const notes = await getCollection('notes', (n) => !n.data.draft && n.data.lang === locale);
const countFor = (slug: string) => notes.filter((n) => n.data.category === slug).length;
---

<BaseLayout locale={locale} page="hello" title={SITE.name} description={t.home.intro}>
  <!-- Hero -->
  <section class="shell" style="padding-top: clamp(56px, 9vw, 104px); padding-bottom: 24px">
    <p class="eyebrow">{t.home.eyebrow}</p>
    <h1 style="font-size: clamp(44px, 7vw, 68px); font-weight: 800; margin-top: 12px">
      {SITE.name}
    </h1>
    <p
      style="margin-top: 14px; font-family: var(--font-mono); font-size: 0.95rem; color: var(--color-ink-2)"
    >
      @{SITE.handle} <span style="color: var(--color-ink-muted)">/</span> {t.home.role}
      <span style="color: var(--color-ink-muted)">/</span> {SITE.location[locale]}
    </p>
    <p
      style="max-width: 38em; margin-top: 22px; font-size: 1.12rem; color: var(--color-ink-2); line-height: 1.75"
    >
      {t.home.intro}
    </p>
  </section>

  <!-- Now -->
  <section class="shell section">
    <div class="section__head">
      <p class="eyebrow">{t.home.now.eyebrow}</p>
      <h2 class="section__title" style="margin-top: 8px">{t.home.now.title}</h2>
    </div>
    <div style="max-width: 46em; font-size: 1rem; color: var(--color-ink-2); line-height: 1.85">
      <p>
        <a class="text-link" href={SITE.peersTouch} rel="noopener" target="_blank">Peers&nbsp;Touch</a>{' '}
        {t.home.now.body}
      </p>
    </div>
  </section>

  <!-- Track record -->
  <section class="shell section">
    <div class="section__head">
      <p class="eyebrow">{t.home.track.eyebrow}</p>
      <h2 class="section__title" style="margin-top: 8px">{t.home.track.title}</h2>
    </div>
    <div class="timeline" style="max-width: 48em">
      {t.home.timeline.map((item) => (
        <div class="timeline__item">
          <p class="timeline__phase">{item.phase}</p>
          <h3 class="timeline__title">{item.title}</h3>
          <div class="timeline__body">
            <ul>
              {item.body.map((line) => <li>{line}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Selected work -->
  <section class="shell section">
    <div class="section__head">
      <p class="eyebrow">{t.home.work.eyebrow}</p>
      <h2 class="section__title" style="margin-top: 8px">{t.home.work.title}</h2>
    </div>
    <div class="card-grid" style="grid-template-columns: minmax(0, 520px)">
      {t.home.work.items.map((work, i) => (
        <a class="index-card" href={work.href} rel="noopener" target="_blank">
          <span class="index-card__number">0{i + 1}</span>
          <h3 class="index-card__title">{work.title}</h3>
          <p class="index-card__body">{work.body}</p>
          <span class="index-card__foot">{work.foot} ↗</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Learning -->
  <section class="shell section" style="margin-bottom: 0">
    <div class="section__head">
      <p class="eyebrow">{t.home.learning.eyebrow}</p>
      <h2 class="section__title" style="margin-top: 8px">
        {t.home.learning.prefix}
        <a class="text-link" href={lpath(locale, '/learn')}>
          {CATEGORIES.map((c) => c.label[locale]).join(' · ')}
        </a>
        {t.home.learning.suffix}
      </h2>
      <p class="section__sub">{t.home.learning.sub}</p>
    </div>
    <div class="chip-row">
      {CATEGORIES.map((c) => (
        <a class="chip" href={lpath(locale, `/learn/${c.slug}`)}>
          {c.label[locale]} <span class="count">{countFor(c.slug)}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
