---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, UI, BLOG_TAGS, tagLabel, lpath, type Locale } from '../lib/i18n';
import { renderedCopyHtml } from '../lib/copy';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];

const posts = await getCollection('posts', (p) => !p.data.draft && p.data.lang === locale);
const countFor = (slug: string) => posts.filter((p) => p.data.tags.includes(slug)).length;

// Long-form copy is authored as paired Markdown in src/content/copy/.
const copyEntries = await getCollection('copy', (p) => p.data.lang === locale);
const copyByKey = new Map(copyEntries.map((c) => [c.id.replace(/\.(en|zh)$/, ''), c]));
const introHtml = renderedCopyHtml(copyByKey.get('home-intro'));
const nowHtml = renderedCopyHtml(copyByKey.get('home-now'));
---

<BaseLayout locale={locale} page="hello" title={SITE.name} description={t.home.metaDescription}>
  <!-- Hero -->
  <section class="shell" style="padding-top: clamp(56px, 9vw, 104px); padding-bottom: 24px">
    <p class="eyebrow">{t.home.eyebrow}</p>
    <h1 style="font-size: clamp(44px, 7vw, 68px); font-weight: 800; margin-top: 12px">
      {SITE.name}
    </h1>
    <p
      style="margin-top: 14px; font-family: var(--font-mono); font-size: 0.95rem; color: var(--color-ink-2)"
    >
      @{SITE.handle} <span style="color: var(--color-ink-muted)">/</span> {t.home.role}
      <span style="color: var(--color-ink-muted)">/</span> {SITE.location[locale]}
    </p>
    <div
      class="copy-prose"
      style="max-width: 38em; margin-top: 22px; font-size: 1.12rem; color: var(--color-ink-2); line-height: 1.75"
    >
      <Fragment set:html={introHtml} />
    </div>
  </section>

  <!-- Now -->
  <section class="shell section">
    <div class="section__head">
      <p class="eyebrow">{t.home.now.eyebrow}</p>
      <h2 class="section__title" style="margin-top: 8px">{t.home.now.title}</h2>
    </div>
    <div
      class="copy-prose"
      style="max-width: 46em; font-size: 1rem; color: var(--color-ink-2); line-height: 1.85"
    >
      <Fragment set:html={nowHtml} />
    </div>
  </section>

  <!-- Selected work -->
  <section class="shell section">
    <div class="section__head">
      <p class="eyebrow">{t.home.work.eyebrow}</p>
      <h2 class="section__title" style="margin-top: 8px">{t.home.work.title}</h2>
    </div>
    <div class="card-grid" style="grid-template-columns: minmax(0, 520px)">
      {t.home.work.items.map((work, i) => (
        <a class="index-card" href={work.href} rel="noopener" target="_blank">
          {work.logo ? (
            <img class="index-card__logo" src={work.logo} alt={`${work.title} logo`} width="44" height="44" />
          ) : (
            <span class="index-card__number">0{i + 1}</span>
          )}
          <h3 class="index-card__title">{work.title}</h3>
          <p class="index-card__body">{work.body}</p>
          <span class="index-card__foot">{work.foot} ↗</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Writing -->
  <section class="shell section" style="margin-bottom: 0">
    <div class="section__head">
      <p class="eyebrow">{t.home.writing.eyebrow}</p>
      <h2 class="section__title" style="margin-top: 8px">
        <a class="text-link" href={lpath(locale, '/blog')}>{t.home.writing.title}</a>
      </h2>
      <p class="section__sub">{t.home.writing.sub}</p>
    </div>
    <div class="chip-row">
      {BLOG_TAGS.map((slug) => (
        <a class="chip" href={lpath(locale, `/blog/tag/${slug}`)}>
          {tagLabel(slug, locale)} <span class="count">{countFor(slug)}</span>
        </a>
      ))}
    </div>
    <div style="margin-top: 24px">
      <a class="text-link" href={lpath(locale, '/blog')} style="font-weight: 600">
        {t.home.writing.cta} →
      </a>
    </div>
  </section>
</BaseLayout>
