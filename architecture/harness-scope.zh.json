{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "边界：模型、Harness 与环境",
    "subtitle": "这个系列讲什么，以及所有 agent 系统都绕不开的三条边界。",
    "locale": "zh-CN",
    "output": "harness-scope.zh.html",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "viewBox": [1200, 600],
